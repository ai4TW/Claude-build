# AllTheCalls.ai — Environment Variables
# Copy this to .env and fill in real values. NEVER commit .env to git.

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-api03-...

# Trillet AI (get from trillet.ai dashboard after signing up for Agency plan)
TRILLET_API_KEY=your-trillet-api-key

# Stripe (for billing clients)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Client Portal Auth
# Secret used to sign JWT session cookies. Change to a random 32+ char string in production.
SESSION_SECRET=change-this-to-a-random-32-char-secret

# Demo mode — set to true for local testing without a real Trillet account
DEMO_MODE=true
DEMO_PASSWORD=demo1234
# Optional: override the demo client's Trillet IDs when using a real account in dev
DEMO_SUB_ACCOUNT_ID=
DEMO_AGENT_ID=

# Production client registry (JSON map of email -> client credentials)
# Format: {"client@email.com":{"password":"pw","clientId":"...","clientName":"...","subAccountId":"...","agentId":"..."}}
# Leave blank when using DEMO_MODE=true
CLIENT_REGISTRY=

# App
NEXT_PUBLIC_APP_URL=https://app.allthecalls.ai
NODE_ENV=development
